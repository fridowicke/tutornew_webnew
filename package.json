{
  "name": "tutornew-web",
  "version": "1.0.0",
  "description": "tutor.new website",
  "scripts": {
    "build": "npm run build:tutor-new",
    "build:tutor-new": "rm -rf _site-tutor-new && cd sites/tutor.new && npx @11ty/eleventy --config=.eleventy.js",
    "serve:tutor-new": "cd sites/tutor.new && npx @11ty/eleventy --config=.eleventy.js --serve",
    "dev:tutor-new": "cd sites/tutor.new && npx @11ty/eleventy --config=.eleventy.js --serve --watch"
  },
