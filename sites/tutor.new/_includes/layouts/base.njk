<!DOCTYPE html>
<html lang="{{ lang | default('de') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NGF9ZRWNSR"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-NGF9ZRWNSR');
    </script>
    <title{% if titleKey %} data-i18n="{{ titleKey }}"{% endif %}>{{ title | default('tutor.new') }}</title>
    <link rel="icon" type="image/png" href="{{ '/quack/quack-avatar.png' | url }}">
    <link rel="apple-touch-icon" href="{{ '/quack/quack-avatar.png' | url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sour+Gummy:wght@400;500;600;700;800&family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/styles.css' | url }}">
    {% if structuredData %}
    <script type="application/ld+json">
    {{ structuredData | safe }}
    </script>
    {% endif %}
    {% if pageStyles %}
    <style>
        {{ pageStyles | safe }}
    </style>
    {% endif %}
    {% if useQ %}
    <link rel="stylesheet" href="{{ '/q.css' | url }}?v=5">
    {% endif %}
</head>
<body>

    <div class="container">
        {% block header %}{% endblock %}
        
        {{ content | safe }}
        
        {% block footer %}{% endblock %}
    </div>

    {% if pageScripts %}
    <script>
        {{ pageScripts | safe }}
    </script>
    {% endif %}
    <!-- i18n (auto language detection + footer switcher) loads on every page -->
    <script src="{{ '/i18n.js' | url }}"></script>
    {% if scripts %}
        {% for script in scripts %}
        {% if '/i18n.js' not in script %}
        <script src="{{ script | url }}"></script>
        {% endif %}
        {% endfor %}
    {% endif %}
</body>
</html>

