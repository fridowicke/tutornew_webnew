<!DOCTYPE html>
<html lang="{{ lang | default('de') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default('tutor.new') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sour+Gummy:wght@400;500;600;700;800&family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/styles.css' | url }}">
    {% if structuredData %}
    <script type="application/ld+json">
    {{ structuredData | safe }}
    </script>
    {% endif %}
    {% if pageStyles %}
    <style>
        {{ pageStyles | safe }}
    </style>
    {% endif %}
    {% if useQ %}
    <link rel="stylesheet" href="{{ '/q.css' | url }}?v=3">
    {% endif %}
</head>
<body>

    <div class="container">
        {% block header %}{% endblock %}
        
        {{ content | safe }}
        
        {% block footer %}{% endblock %}
    </div>

    {% if pageScripts %}
    <script>
        {{ pageScripts | safe }}
    </script>
    {% endif %}
    {% if scripts %}
        {% for script in scripts %}
        <script src="{{ script | url }}"></script>
        {% endfor %}
    {% else %}
        <script src="{{ '/i18n.js' | url }}"></script>
    {% endif %}
</body>
</html>

